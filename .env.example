# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM BOT INTEGRATION: Required for live channel membership verification
# Create a bot via @BotFather and add it as an administrator to your official channel
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHANNEL_ID="@earnova_official"

# SUPABASE INTEGRATION (Optional - fallback persistent ledger is active if not set)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh...your-service-role-key"

# ADMIN PANEL SECURITY: Key required to perform admin operations
ADMIN_SECRET_KEY="earnova_admin_secret_passphrase"
